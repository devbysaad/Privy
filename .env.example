# Clerk auth (custom sign-in / sign-up UI)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Supabase Postgres (Settings → Database → Connection string)
DATABASE_URL=
# Direct (non-pooler) URL for migrations / prisma db push
DIRECT_URL=

# Fastn MCP (https://mcp.fastn.dev/shttp) — required for live scans
FASTN_API_KEY=
# Prefer project id from Fastn; SPACE_ID is accepted as an alias
FASTN_PROJECT_ID=
# FASTN_SPACE_ID=
# Optional override (default https://mcp.fastn.dev/shttp)
# FASTN_MCP_URL=https://mcp.fastn.dev/shttp

# LLM (optional — template explanations used when missing)
# Prefer Gemini; Anthropic is a fallback
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_API_KEY=

# Company email domain for external-collaborator heuristic
COMPANY_EMAIL_DOMAIN=acme.com

# Demo remediation target (throwaway GitHub repo only)
DEMO_GITHUB_OWNER=
DEMO_GITHUB_REPO=

# Dry-run ON by default. Set to false only for the stage write.
REMEDIATION_DRY_RUN=true
