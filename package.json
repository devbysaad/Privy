{
  "name": "ai-access-investigator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "check:rules": "npx --yes tsx src/lib/rules/check.ts",
    "check:connectors": "npx --yes tsx scripts/check-connectors.ts",
    "check:connections": "npx --yes tsx scripts/check-connections.ts",
    "seed:demo": "npx --yes tsx scripts/seed-demo.ts",
    "rehearse": "npx --yes tsx scripts/rehearse.ts",
    "check:intelligence": "npx --yes tsx src/lib/intelligence/check.ts",
    "check": "tsx src/lib/rules/check.ts && tsx scripts/check-connectors.ts && tsx scripts/check-connections.ts && tsx src/lib/intelligence/check.ts",
    "prepare:demo": "prisma generate && prisma db push && npm run seed:demo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@base-ui/react": "^1.8.0",
